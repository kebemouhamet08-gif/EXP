# Remplacer par une valeur longue et aléatoire hors du dépôt.
CLASSEXP_ENV=development
CLASSEXP_SECRET_KEY=
# Mettre à 1 uniquement lorsque le site est servi en HTTPS.
CLASSEXP_HTTPS=0

# SQLite/local sont autorises uniquement hors production.
DATABASE_URL=sqlite:///database/classexp.db
STORAGE_BACKEND=local

# SMTP utilisé pour envoyer les liens de réinitialisation à l'adresse du compte.
CLASSEXP_MAIL_HOST=smtp.example.com
CLASSEXP_MAIL_PORT=587
CLASSEXP_MAIL_USERNAME=compte@example.com
CLASSEXP_MAIL_PASSWORD=
CLASSEXP_MAIL_FROM=no-reply@example.com
CLASSEXP_BASE_URL=http://127.0.0.1:5000

# Cloudflare R2 ou autre endpoint S3 compatible (bucket prive).
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto

# Fournisseurs OAuth — utilisés dans les phases dédiées.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=v25.0
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
